PORT=3000

# PostgreSQL settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=db_name

# Database Configuration
DATABASE_URL="postgres://postgres:password@localhost:5432/db_name"

# Better Auth Configuration
BETTER_AUTH_SECRET="secret"
BETTER_AUTH_URL="http://localhost:3000"

# Resend Configuration
RESEND_API_KEY=""
EMAIL_SENDER="Insitu <no-reply@laboratorioinsitu.cl>"

# DEV/QA ONLY — si está seteado, sendProgramacionEmail manda TODOS los correos
# acá en vez de al email real del cliente. Dejar vacío/comentado en producción.
# EMAIL_TEST_OVERRIDE=""

# Public backend URL (used for generating quotation response links in emails)
# In production, set to your actual backend domain (e.g. https://api.laboratorioinsitu.cl)
BACKEND_PUBLIC_URL="http://localhost:3000"

# Admin frontend URL (CORS + admin-facing error redirects)
FRONTEND_URL="http://localhost:5173"

# Landing page URL (used in client-facing links: visit scheduling email,
# quotation accept/reject flow, payment upload)
LANDING_PAGE_URL="http://localhost:3001"

# Quotation response token TTL in days (default: 7)
# This controls how long the ACCEPT/REJECT links in client emails remain valid
QUOTATION_TOKEN_TTL_DAYS=7

# Google OAuth Configuration
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Options: development, production, test
# Note: Set to 'production' to disable pino-pretty and output raw JSON logs.
NODE_ENV=development

# Logger Level
# Options: fatal, error, warn, info, debug, trace, silent
LOG_LEVEL=debug